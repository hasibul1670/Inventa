{
  "info": {
    "name": "IMS Nest Microservices - Tenant DB",
    "description": "Postman collection for the database-per-tenant IMS architecture. Use Auth Service / Tenant Provisioning / Create Tenant first. It creates the tenant, admin user, and tenant-specific party/inventory/sales databases, then saves accessToken, tenantId, and database names as collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "tenantId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "customerId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "supplierId",
      "value": ""
    },
    {
      "key": "productId",
      "value": "22222222-2222-2222-2222-222222222222"
    },
    {
      "key": "warehouseId",
      "value": "33333333-3333-3333-3333-333333333333"
    },
    {
      "key": "saleId",
      "value": "44444444-4444-4444-4444-444444444444"
    },
    {
      "key": "invoiceId",
      "value": "55555555-5555-5555-5555-555555555555"
    },
    {
      "key": "partyDatabase",
      "value": ""
    },
    {
      "key": "inventoryDatabase",
      "value": ""
    },
    {
      "key": "salesDatabase",
      "value": ""
    },
    {
      "key": "productSku",
      "value": "SKU-001"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth Service",
      "description": "Auth routes and tenant provisioning. Start here for every new client.",
      "item": [
        {
          "name": "Tenant Provisioning",
          "description": "Creates the new client tenant and immediately creates tenant-specific party, inventory, and sales databases.",
          "item": [
            {
              "name": "Create Tenant and Provision DBs",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "const data = json.data || json;",
                      "if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                      "if (data.tenantId) pm.collectionVariables.set('tenantId', data.tenantId);",
                      "if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id);",
                      "if (data.databases && data.databases.party) pm.collectionVariables.set('partyDatabase', data.databases.party.database);",
                      "if (data.databases && data.databases.inventory) pm.collectionVariables.set('inventoryDatabase', data.databases.inventory.database);",
                      "if (data.databases && data.databases.sales) pm.collectionVariables.set('salesDatabase', data.databases.sales.database);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"companyName\": \"Demo Trading Company\",\n  \"fullName\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": "{{baseUrl}}/auth/tenants",
                "description": "Creates a new tenant/client, admin user, and tenant-specific party/inventory/sales databases."
              }
            },
            {
              "name": "Register Tenant Admin and Provision DBs",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "const data = json.data || json;",
                      "if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                      "if (data.tenantId) pm.collectionVariables.set('tenantId', data.tenantId);",
                      "if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id);",
                      "if (data.databases && data.databases.party) pm.collectionVariables.set('partyDatabase', data.databases.party.database);",
                      "if (data.databases && data.databases.inventory) pm.collectionVariables.set('inventoryDatabase', data.databases.inventory.database);",
                      "if (data.databases && data.databases.sales) pm.collectionVariables.set('salesDatabase', data.databases.sales.database);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"companyName\": \"Demo Trading Company\",\n  \"fullName\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": "{{baseUrl}}/auth/register",
                "description": "Backward-compatible registration route. It also provisions tenant-specific business databases."
              }
            }
          ]
        },
        {
          "name": "Authentication",
          "description": "Login against the shared user/control database.",
          "item": [
            {
              "name": "Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "const data = json.data || json;",
                      "if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                      "if (data.user && data.user.tenantId) pm.collectionVariables.set('tenantId', data.user.tenantId);",
                      "if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": "{{baseUrl}}/auth/login",
                "description": "Logs in from the shared ims_users control database and saves accessToken/tenantId."
              }
            }
          ]
        }
      ]
    },
