{
  "info": {
    "name": "IMS Nest Microservices - Organized",
    "description": "Organized initial test collection for the NestJS inventory-management-system API gateway. Folders are grouped by service, then by resource. Empty planned folders mark backend routes that do not exist yet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "tenantId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "customerId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "supplierId",
      "value": ""
    },
    {
      "key": "productId",
      "value": "22222222-2222-2222-2222-222222222222"
    },
    {
      "key": "warehouseId",
      "value": "33333333-3333-3333-3333-333333333333"
    },
    {
      "key": "saleId",
      "value": "44444444-4444-4444-4444-444444444444"
    },
    {
      "key": "invoiceId",
      "value": "55555555-5555-5555-5555-555555555555"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth Service",
      "description": "Auth and tenant bootstrap routes exposed by api-gateway and handled by auth-tenant-service.",
      "item": [
        {
          "name": "Authentication",
          "description": "Register/login routes. Run Register Tenant Admin first to save accessToken and tenantId.",
          "item": [
            {
              "name": "Register Tenant Admin",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "const data = json.data || json;",
                      "if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                      "if (data.tenantId) pm.collectionVariables.set('tenantId', data.tenantId);",
                      "if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"companyName\": \"Demo Trading Company\",\n  \"fullName\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": "{{baseUrl}}/auth/register"
              }
            },
            {
              "name": "Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "const data = json.data || json;",
                      "if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                      "if (data.user && data.user.tenantId) pm.collectionVariables.set('tenantId', data.user.tenantId);",
                      "if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": "{{baseUrl}}/auth/login"
              }
            }
          ]
        }
      ]
    },
