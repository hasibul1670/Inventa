{
  "name": "a-z-inventory-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS TCP microservices boilerplate for an A-Z inventory management system.",
  "scripts": {
    "build": "nest build api-gateway && nest build auth-tenant-service && nest build user-service && nest build party-service && nest build inventory-service && nest build sales-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:gateway": "nest start api-gateway --watch",
    "start:auth": "nest start auth-tenant-service --watch",
    "start:user": "nest start user-service --watch",
    "start:party": "nest start party-service --watch",
    "start:inventory": "nest start inventory-service --watch",
    "start:sales": "nest start sales-service --watch",
    "start:dev:all": "concurrently \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:user\" \"npm run start:party\" \"npm run start:inventory\" \"npm run start:sales\"",
    "seed:products": "ts-node --transpile-only scripts/seed-products.ts",
    "typeorm": "typeorm-ts-node-commonjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
